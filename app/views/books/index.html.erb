<p id="notice"><%= notice %></p>

<%= link_to "Viewing All", books_path %> -
<%= link_to "Viewing Read", books_path(read: true) %> -
<%= link_to "Viewing Unread", books_path(read: false) %>

<% if @filter == "read" %>
    <h1>Read Books</h1>
<% elsif @filter == "unread" %>
    <h1>Unread Books</h1>
<% else %>
    <h1>All Books</h1>
<% end %>

<table>
  <thead>
    <tr>
      <th>Title</th>
      <th>Author</th>
      <th>Read</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @books.each do |book| %>
      <tr>
        <td><%= book.title %></td>
        <td><%= book.author %></td>
        <td><%= book.read %></td>
        <td><%= link_to 'Show', book %></td>
        <td><%= link_to 'Edit', edit_book_path(book) %></td>
        <td><%= link_to 'Destroy', book, method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'New Book', new_book_path %>
